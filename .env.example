# Nano Beauty local configuration template.
# Create your local copy with 06-CREATE-LOCAL-ENV.cmd, then edit values yourself.
# Never commit real credentials. Every value below is optional for local development:
# with no .env at all the API boots on in-memory PGlite and the dev app finds the API on the Metro host.

# ---------- API (apps/api) ----------
NODE_ENV=development
# development | staging | production. Staging/production require DATABASE_URL; production refuses dev adapters.
APP_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Unset = in-memory PGlite (data lost on restart). For Docker Postgres (npm run db:up) use:
# DATABASE_URL=postgres://nano:nano_dev_only@127.0.0.1:5432/nano
# Only deterministic development adapters exist until vendors are approved (OTP code in dev: 000000).
INTEGRATIONS_MODE=dev
# Fresha hand-off link (D33). There is no Fresha booking API; leave unset until the clinic supplies the URL.
# FRESHA_BOOKING_URL=
# Reverse-proxy hops in front of the API (0 = clients connect directly). Used for the per-client sign-in throttle.
TRUST_PROXY=0
# Local development only (refused unless APP_ENV=development):
# DEV_OTP_SINK=true exposes the last code sent to a number at GET /v1/dev/otp?phone=... (codes are never logged).
DEV_OTP_SINK=false
# DEV_SAMPLE_LEGACY=true serves sample old-app records so the account match (AUT-05…07) can be exercised.
DEV_SAMPLE_LEGACY=false
# DEV_SAMPLE_FRESHA=true pretends Fresha shares bookings back for (604) 555-0123 so Visits and the BKG-09 return
# check can be exercised. Without it the app shows the honest "Your bookings are in Fresha" state.
DEV_SAMPLE_FRESHA=false

# ---------- Local Postgres (compose.yaml) ----------
POSTGRES_USER=nano
POSTGRES_PASSWORD=nano_dev_only
POSTGRES_DB=nano

# ---------- Mobile (apps/mobile) ----------
# Expo reads these from the shell / EAS profile at build time (see docs/development.md).
# APP_VARIANT=development
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# EAS_PROJECT_ID=
# EXPO_OWNER=
