{
  "name": "@nano/api",
  "version": "0.0.0",
  "private": true,
  "description": "Nano Beauty clinic API: settings, permissions, content, ledgers, audit, integration boundaries.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsup",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate:built": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nano/contracts": "*",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
