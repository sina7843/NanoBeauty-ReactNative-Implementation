{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" },
      "android": { "buildType": "apk" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "qa": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_URL": "https://api.staging.nanobeauty.invalid"
      },
      "android": { "buildType": "apk" }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_URL": "https://api.staging.nanobeauty.invalid"
      },
      "android": { "buildType": "app-bundle" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://api.nanobeauty.invalid"
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "testflight": {
      "android": { "track": "internal", "releaseStatus": "draft" },
      "ios": {}
    },
    "production": {
      "android": { "track": "production", "releaseStatus": "draft" },
      "ios": {}
    }
  }
}
