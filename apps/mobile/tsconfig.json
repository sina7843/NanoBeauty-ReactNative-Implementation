{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "phosphor-react-native/src/icons/*": [
        "../../node_modules/phosphor-react-native/lib/typescript/icons/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
